# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_EMAIL_FALLBACK={phone}@calls.aangan.example

# Telegram: bot token from @BotFather, plus group chat ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_SENIOR_CHAT_ID=

# HubSpot private-app token; stage must be an internal stage id from your pipeline
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled
