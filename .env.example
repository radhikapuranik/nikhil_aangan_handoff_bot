# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# Must be a real inbox (Cal.com rejects made-up domains). Use a + alias so each booking is distinguishable.
CALCOM_EMAIL_FALLBACK=studio+{phone}@yourdomain.com

# Telegram: bot token from @BotFather, plus group chat ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_SENIOR_CHAT_ID=

# HubSpot private-app token; stage must be an internal stage id from your pipeline
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled   # replace with an internal stage id from YOUR pipeline (GET /crm/v3/pipelines/deals)

# Voice platform <-> brain
BRAIN_SHARED_SECRET=            # the voice platform sends this as a Bearer token
VAANI_WEBHOOK_SECRET=           # vv_whk_... shown once when you create the webhook in Vaani

# Dashboard (Vercel). Required: the page shows caller data.
DASHBOARD_PASSWORD=
# DEMO_MODE=1 serves sample data when Supabase is not configured (never use with real calls)
